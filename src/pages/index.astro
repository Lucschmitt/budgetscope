---
import Base from '../layouts/Base.astro';
import SimulateurWrapper from '../components/SimulateurWrapper';

const budgetList = [
  { id: 'plf_2025',  label: 'PLF 2025',      file: '/budgetscope/data/budget_2025.json' },
  { id: 'exec_2025', label: 'Exécuté 2025',   file: '/budgetscope/data/budget_2025_exec.json' },
  { id: 'plf_2026',  label: 'PLF 2026',       file: '/budgetscope/data/budget_2026_plf.json' },
];

---

<Base title="BudgetScope — Simulateur" description="Simulateur interactif des finances publiques françaises">
  <SimulateurWrapper
    client:load
    budgetList={budgetList}
    programmeIndexFile="/budgetscope/data/programmes/programmes_index.json"
    catalogueFile="/budgetscope/data/mesures/catalogue.json"
    multiplicateursFile="/budgetscope/data/mesures/multiplicateurs.json"
  />
</Base>
