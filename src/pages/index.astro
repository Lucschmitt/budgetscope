---
import Base from '../layouts/Base.astro';
import Simulateur from '../components/Simulateur';
import budgetData from '../data/budget_2025.json';
---

<Base title="Simulateur" description="Simulateur interactif des finances publiques françaises 2025">

  <div class="hero">
    <p class="hero-line">
      <strong class="hero-title">Équilibrez le budget de la France</strong>
      <span class="hero-sep">—</span>
      Cochez les propositions pour voir leur impact sur le déficit, la dette et la croissance. Cliquez sur les nœuds et les flux pour voir le détail.
    </p>
  </div>

  <Simulateur data={budgetData} client:load />

</Base>

<style>
  .hero {
    padding: 0.6rem 1rem 0.4rem;
  }
  .hero-line {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .hero-title {
    font-weight: 700;
    color: var(--text-primary);
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .hero-sep {
    color: var(--text-muted);
  }
</style>
